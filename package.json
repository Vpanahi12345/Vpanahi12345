{
  "name": "amlakpro",
  "version": "1.0.2",
  "description": "سامانه هوشمند مدیریت املاک و بنگاه‌های معاملاتی — AmlakPro Real Estate Manager",
  "author": "AmlakPro",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ir.amlakpro.app",
    "productName": "AmlakPro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "index.html",
      "css/**",
      "js/**",
      "assets/**",
      "version.json"
    ],
    "asar": false,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AmlakPro",
      "artifactName": "AmlakPro-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "AmlakPro-Portable-${version}.${ext}"
    }
  }
}
